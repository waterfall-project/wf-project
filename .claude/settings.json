{
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(gh api graphql:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(git push:*)",
      "Bash(git branch -d:*)",
      "Bash(git worktree unlock:*)",
      "Bash(git worktree remove:*)",
      "Bash(make tracking:*)",
      "Bash(make slot:*)",
      "Bash(make slot-release:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/src/wftools/guard.py\""
          }
        ]
      }
    ]
  }
}
