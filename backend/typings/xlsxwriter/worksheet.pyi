# The worksheet of XlsxWriter, as the writer of the estimate uses it.

from xlsxwriter.format import Format

class Worksheet:
    def write(self, *args: object) -> int: ...
    def write_string(self, *args: object) -> int: ...
    def write_number(self, *args: object) -> int: ...
    def write_formula(self, *args: object) -> int: ...
    def write_row(self, *args: object) -> int: ...
    def write_comment(self, *args: object) -> int: ...
    def add_table(self, *args: object) -> object: ...
    def data_validation(self, *args: object) -> int: ...
    def insert_image(self, *args: object) -> int: ...
    def set_column(
        self,
        first_col: int,
        last_col: int,
        width: float | None = None,
        cell_format: Format | None = None,
        options: dict[str, object] | None = None,
    ) -> int: ...
    def set_row(self, row: int, height: float | None = None) -> int: ...
    def freeze_panes(self, row: int, col: int) -> None: ...
    def print_area(self, first_row: int, first_col: int, last_row: int, last_col: int) -> int: ...
    def fit_to_pages(self, width: int, height: int) -> None: ...
    def protect(self, password: str = "", options: dict[str, object] | None = None) -> None: ...
    def set_footer(self, footer: str = "") -> None: ...
    def activate(self) -> None: ...
