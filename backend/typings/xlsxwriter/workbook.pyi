# The workbook of XlsxWriter, as the writer of the estimate uses it.

from datetime import datetime
from io import BytesIO

from xlsxwriter.format import Format
from xlsxwriter.worksheet import Worksheet

class Workbook:
    def __init__(
        self, filename: str | BytesIO, options: dict[str, object] | None = None
    ) -> None: ...
    def add_worksheet(self, name: str | None = None) -> Worksheet: ...
    def add_format(self, properties: dict[str, object] | None = None) -> Format: ...
    def set_properties(self, properties: dict[str, str | datetime]) -> None: ...
    def set_calc_mode(self, mode: str) -> None: ...
    def worksheets(self) -> list[Worksheet]: ...
    def close(self) -> None: ...
