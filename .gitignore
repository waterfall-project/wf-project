.build/
__pycache__/
# Fichiers de verrou et sauvegardes de Word et draw.io
~$*
.$*.bkp
/docs/spec/images/
stb-waterfall.docx.before*
docs/api/*.bundle.yaml
docs/api/*.bundle.json
.venv/
node_modules/
.next/
coverage/
# The cache of ESLint (`pnpm lint`) and the reports of the parts of the tests of the front
# (`make coverage-front SHARD=i/N`).
.eslintcache
.vitest/
next-env.d.ts
*.tsbuildinfo
docs/api/waterfall.mock.json
docs/api/waterfall.proxy.json
frontend/.e2e/
backend/coverage.json
backend/coverage-keycloak.json
# The measures of the parts of the tests of the back (`make coverage-back SHARD=i/N`).
backend/.coverage-parts/
.coverage
# Parallel coverage data files (`.coverage.<host>.pid<n>.<random>`), left behind by an interrupted `make check`/`make check-back`
.coverage.*
test-results/
playwright-report/
# Schémas XML de MS Project, non redistribuables : lus sur le poste, jamais versionnés
/docs/schemas/
# Variables d'un poste pour la plateforme de développement (WATERFALL_DEV_ORIGINS)
deploy/compose/.env
# The contract the public demonstration serves, copied beside its compose file
deploy/compose/waterfall.mock.json
# Ce que la construction locale de l'extension Keycloak laisse
deploy/keycloak/extension/target/
# La racine de l'autorité du frontal de Keycloak, copiée de la plateforme de service (make service-up)
deploy/compose/.authority/
# L'autorité que l'exploitant fournit à la plateforme de production, sa clé comprise (US-2840)
deploy/compose/authority/
# Le certificat de la porte que l'exploitant fournit, sa clé comprise (US-3010)
deploy/compose/door/
# Le fichier des emplacements de copie externe que l'exploitant écrit : il porte les clés d'un S3 (#4655)
deploy/compose/external-locations.json
# Ce qu'un agent écrit dans son worktree, le journal de `make check` (US-1100)
.waterfall/
# Les réglages de l'éditeur, propres à chaque poste
.vscode/
