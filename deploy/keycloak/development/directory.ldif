# The directory of test of the development platform (WF-ADM-0180): one person, whom Keycloak
# federates (development/waterfall.yaml). Her password is a development value, visible. Loaded once,
# by slapadd, at the first start of the directory (deploy/openldap/entrypoint.sh): its first entry
# is that of the suffix of the base.

dn: dc=waterfall,dc=test
objectClass: dcObject
objectClass: organization
dc: waterfall
o: Waterfall (development)

dn: ou=people,dc=waterfall,dc=test
objectClass: organizationalUnit
ou: people

dn: uid=dominique.annuaire,ou=people,dc=waterfall,dc=test
objectClass: inetOrgPerson
uid: dominique.annuaire
cn: Dominique Annuaire
givenName: Dominique
sn: Annuaire
mail: dominique.annuaire@waterfall.test
userPassword: development-only-directory-password
