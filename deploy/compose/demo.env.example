# The settings and the secrets of the public demonstration (compose.demo.yaml, README.md). Copy this
# file to .env beside it, readable by its owner alone (chmod 600 .env), and fill every value.
# Values holding a `$` — the hash below — stay between single quotes: Compose leaves them as they are.

# The name of the machine, which its DNS points to; ports 80 and 443 open to the Internet.
WATERFALL_DOMAIN=demo.waterfall-project.pro
# The address Let's Encrypt writes to before a certificate expires.
WATERFALL_ACME_EMAIL=
# The images of the front to run, as the chain publishes them on ghcr.io/waterfall-project: a
# version (0.1.0), the full hash of a commit, or a branch made a tag (epic-EP-15, main).
WATERFALL_IMAGE_TAG=
# The version of Prism, the one the Makefile pins (PRISM_VERSION).
PRISM_VERSION=5.16.0

# The shared account of the visitors, and the bcrypt hash of its password:
#   docker run --rm caddy:2.11.7-alpine caddy hash-password
WATERFALL_DEMO_USER=demo
WATERFALL_DEMO_PASSWORD_HASH=''
# The key of the server actions of Next: openssl rand -base64 32
WATERFALL_SERVER_ACTIONS_KEY=
