# SPDX-License-Identifier: AGPL-3.0-only

# The settings and the secrets of the production platform (compose.prod.yaml, README.md). Copy this
# file to .env beside it, readable by its owner alone (chmod 600 .env), and fill every value: a
# service that lacks one stops, naming it. Nothing here is versioned once filled: .env is ignored
# by git. Keep a copy of the secrets apart: a backup restored elsewhere asks for the same ones.

# --- Settings ----------------------------------------------------------------------------------

# The name of the machine, which its DNS points to: Caddy obtains its certificates from Let's
# Encrypt, and the browser reaches the platform at https://<domain>. Ports 80 and 443 open to the
# Internet. A local name — localhost, *.localhost, *.internal — takes compose.prod.local.yaml too.
WATERFALL_DOMAIN=
# The address Let's Encrypt writes to before a certificate expires.
WATERFALL_ACME_EMAIL=
# The images to run, as the chain publishes them on ghcr.io/waterfall-project: a version (0.1.0),
# the full hash of a commit, or a branch made a tag (epic-EP-03, main).
WATERFALL_IMAGE_TAG=
# The first administrator, made by the bootstrap, and the language of the installation (fr or en).
WATERFALL_ADMIN_EMAIL=
WATERFALL_DEFAULT_LANGUAGE=fr
# The single currency of the installation, three capital letters (EUR), and the name of the company
# that uses it, from 1 to 200 characters, which the exported files carry: the bootstrap writes them
# once. The currency never changes afterwards; the name changes on the screen of the cost settings.
WATERFALL_CURRENCY=
WATERFALL_COMPANY_NAME=
# The time zone of the installation, its name in the IANA database (Europe/Paris), in which the
# current day is taken: UTC if empty, at the first run. The bootstrap writes it once, and it never
# changes afterwards; a later run that gives another says it ignored.
WATERFALL_TIME_ZONE=
# How often the scheduler asks what is due, in seconds: five minutes. A whole number above zero:
# anything else stops the scheduler.
WATERFALL_SCHEDULE_INTERVAL=300
# The interval of the reading of the accounts of the identity provider, in seconds: a day.
WATERFALL_IDENTITY_SYNC_INTERVAL=86400
# The interval of the purge of what expired — imports, deposits and exports past their term, the
# undo history of the sessions over, the tasks ended —, in seconds: ten minutes. A whole number
# above zero. The purge is a task the worker runs.
WATERFALL_PURGE_INTERVAL=600
# How long the undo history of a session is kept, in hours: twelve, the longest session of the
# realm. A whole number above zero.
WATERFALL_UNDO_RETENTION_HOURS=12
# How long the result of a task ended is kept, in days: thirty. A whole number above zero.
WATERFALL_BACKGROUND_TASK_RETENTION_DAYS=30
# How long an entry of the cache of the indicators of the current day stays valid, in seconds: ten
# minutes. A whole number above zero. A write that changes what the indicators depend on makes the
# entry unused at once; this only bounds what Redis keeps.
WATERFALL_INDICATORS_CACHE_TTL=600
# The number of the processes the API serves on, a whole number above zero: one for each core of the
# host, as long as its memory holds — about 0.7 GB for each, and PostgreSQL counts fifteen
# connections for each (README.md, « Les processus de l'API »). Set it to as many as the host has
# cores, without going above four: four is a measured ceiling (docs/measures/processes.json), and
# above it the measure is to be replayed.
WATERFALL_API_PROCESSES=4
# The ports Caddy is published on, when not 80 and 443: an HTTPS port other than 443 enters the
# address of the platform, https://<domain>:<port>.
# WATERFALL_HTTP_PORT=80
# WATERFALL_HTTPS_PORT=443
# The port the front and the worker serve their metrics on (WF-OBS-0010), where Prometheus collects
# them: inside the network of the platform, published nowhere; the door answers 404 to /metrics.
# WATERFALL_METRICS_PORT=9100
# The capacities, in bytes, of the space PostgreSQL and the object storage keep their data in — the
# disk of their volumes, postgres-data and storage-data —, of which the metrics say what is left and
# the alert of a full storage the occupancy: 10737418240 for 10 GiB. Required. Declare the space
# really available to the data of Waterfall: the "used" measure counts only the database of Waterfall
# and the objects, not the database of Keycloak nor the WAL sharing the volume, and a capacity declared
# too large would make the alert at 85 % optimistic.
WATERFALL_DATABASE_CAPACITY_BYTES=
WATERFALL_STORAGE_CAPACITY_BYTES=
# The thresholds of the alerts (WF-OBS-0030): the wait of the oldest task queued, in seconds, fifteen
# minutes; the occupancy of a space, from which it is nearly full, a ratio above 0, at most 1, 85 %;
# the share of the requests answered in error, a ratio, 5 %, over a window in seconds, five minutes.
# Anything else stops Prometheus, naming it.
WATERFALL_TASK_QUEUE_AGE_THRESHOLD_SECONDS=900
WATERFALL_STORAGE_USAGE_THRESHOLD=0.85
WATERFALL_ERROR_RATE_THRESHOLD=0.05
WATERFALL_ERROR_RATE_WINDOW_SECONDS=300
# The notification of the alerts by e-mail (US-2880): the mail server Alertmanager sends each alert
# through, host:port, the sender and the recipient. Without a server, nothing is notified, and the
# alerts stay on the status screen and the dashboard; with one, the sender and the recipient are
# required; the recipient is one address alone, a list is refused (a distribution list of the mail
# server does the rest). The server is asked for TLS unless REQUIRE_TLS says false. When it asks to sign in, the
# user, and the password below among the secrets. Anything else stops Alertmanager, naming it.
WATERFALL_ALERT_SMTP_HOST=
WATERFALL_ALERT_SMTP_FROM=
WATERFALL_ALERT_RECIPIENT=
# WATERFALL_ALERT_SMTP_REQUIRE_TLS=true
# WATERFALL_ALERT_SMTP_USER=
# The account of the operator on the dashboard, Grafana, served at https://<domain>/grafana, which
# is no account of the realm.
# WATERFALL_GRAFANA_ADMIN_USER=operator

# --- Secrets -----------------------------------------------------------------------------------
# Each one drawn at random, never reused elsewhere. Those written in a URL hold letters and digits
# alone: `openssl rand -hex 24` gives one.

# The administrator of the server PostgreSQL, postgres, by which the services of initialisation alone
# create the roles and the databases; read at its first start alone, which makes it. To change it
# afterwards: ALTER ROLE postgres PASSWORD '...' in the container, then here.
WATERFALL_POSTGRES_ADMIN_PASSWORD=
# The owner of the tables, waterfall, no superuser, by which the migrations, the bootstrap and the
# service of the restoration pass. Letters and digits.
WATERFALL_POSTGRES_PASSWORD=
# The role of the service, by which the API and the worker connect. Letters and digits.
WATERFALL_SERVICE_DATABASE_PASSWORD=
# The role of the backup, a member of pg_read_all_data. Letters and digits.
WATERFALL_BACKUP_DATABASE_PASSWORD=
# The role of Keycloak, owner of its database, by which the service of the restoration replaces it
# too. Letters and digits.
WATERFALL_KEYCLOAK_DATABASE_PASSWORD=
# Redis. Letters and digits.
WATERFALL_REDIS_PASSWORD=
# The administrator `admin` of the realm master of Keycloak, read at its first start alone.
WATERFALL_KEYCLOAK_ADMIN_PASSWORD=
# The clients of the realm waterfall: the front, the service account of the API and the worker, and
# the bootstrap.
WATERFALL_FRONT_CLIENT_SECRET=
WATERFALL_SERVICE_CLIENT_SECRET=
WATERFALL_INSTALLATION_CLIENT_SECRET=
# The key of the server actions of the front: `openssl rand -base64 32`.
WATERFALL_SERVER_ACTIONS_KEY=
# The key of the platform on its object storage, Garage: its identifier, GK followed by 24
# hexadecimal digits, which is no secret, and its secret, `openssl rand -hex 32`.
WATERFALL_STORAGE_ACCESS_KEY=GK000000000000000000000001
WATERFALL_STORAGE_SECRET=
# The internal channel of Garage: 64 hexadecimal digits, `openssl rand -hex 32`.
WATERFALL_STORAGE_RPC_SECRET=
# The password of the account of the dashboard, Grafana, which has its own and not the realm's
# (TFX-15): `openssl rand -hex 24`. Required: Grafana does not start without it.
WATERFALL_GRAFANA_ADMIN_PASSWORD=
# The password of the mail server of the alerts, if it asks to sign in (WATERFALL_ALERT_SMTP_USER),
# on a single line.
# WATERFALL_ALERT_SMTP_PASSWORD=
