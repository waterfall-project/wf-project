# The settings and the secrets of the production platform (compose.prod.yaml, README.md). Copy this
# file to .env beside it, readable by its owner alone (chmod 600 .env), and fill every value: a
# service that lacks one stops, naming it. Nothing here is versioned once filled: .env is ignored
# by git. Keep a copy of the secrets apart: a backup restored elsewhere asks for the same ones.

# --- Settings ----------------------------------------------------------------------------------

# The name of the machine, which its DNS points to: Caddy obtains its certificates from Let's
# Encrypt, and the browser reaches the platform at https://<domain>. Ports 80 and 443 open to the
# Internet. A local name — localhost, *.localhost, *.internal — takes compose.prod.local.yaml too.
WATERFALL_DOMAIN=
# The address Let's Encrypt writes to before a certificate expires.
WATERFALL_ACME_EMAIL=
# The images to run, as the chain publishes them on ghcr.io/waterfall-project: a version (0.1.0),
# the full hash of a commit, or a branch made a tag (epic-EP-03, main).
WATERFALL_IMAGE_TAG=
# The first administrator, made by the bootstrap, and the language of the installation (fr or en).
WATERFALL_ADMIN_EMAIL=
WATERFALL_DEFAULT_LANGUAGE=fr
# The interval of the reading of the accounts of the identity provider, in seconds: a day.
WATERFALL_IDENTITY_SYNC_INTERVAL=86400
# The ports Caddy is published on, when not 80 and 443: an HTTPS port other than 443 enters the
# address of the platform, https://<domain>:<port>.
# WATERFALL_HTTP_PORT=80
# WATERFALL_HTTPS_PORT=443

# --- Secrets -----------------------------------------------------------------------------------
# Each one drawn at random, never reused elsewhere. Those written in a URL hold letters and digits
# alone: `openssl rand -hex 24` gives one.

# The administrator of the server PostgreSQL, postgres, by which the services of initialisation alone
# create the roles and the databases; read at its first start alone, which makes it. To change it
# afterwards: ALTER ROLE postgres PASSWORD '...' in the container, then here.
WATERFALL_POSTGRES_ADMIN_PASSWORD=
# The owner of the tables, waterfall, no superuser, by which the migrations and the bootstrap pass.
# Letters and digits.
WATERFALL_POSTGRES_PASSWORD=
# The role of the service, by which the API and the worker connect. Letters and digits.
WATERFALL_SERVICE_DATABASE_PASSWORD=
# The role of the backup, a member of pg_read_all_data. Letters and digits.
WATERFALL_BACKUP_DATABASE_PASSWORD=
# The role of Keycloak, owner of its database.
WATERFALL_KEYCLOAK_DATABASE_PASSWORD=
# Redis. Letters and digits.
WATERFALL_REDIS_PASSWORD=
# The administrator `admin` of the realm master of Keycloak, read at its first start alone.
WATERFALL_KEYCLOAK_ADMIN_PASSWORD=
# The clients of the realm waterfall: the front, the service account of the API and the worker, and
# the bootstrap.
WATERFALL_FRONT_CLIENT_SECRET=
WATERFALL_SERVICE_CLIENT_SECRET=
WATERFALL_INSTALLATION_CLIENT_SECRET=
# The key of the server actions of the front: `openssl rand -base64 32`.
WATERFALL_SERVER_ACTIONS_KEY=
# The key of the platform on its object storage, Garage: its identifier, GK followed by 24
# hexadecimal digits, which is no secret, and its secret, `openssl rand -hex 32`.
WATERFALL_STORAGE_ACCESS_KEY=GK000000000000000000000001
WATERFALL_STORAGE_SECRET=
# The internal channel of Garage: 64 hexadecimal digits, `openssl rand -hex 32`.
WATERFALL_STORAGE_RPC_SECRET=
